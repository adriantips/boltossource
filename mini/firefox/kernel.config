# BoltOS Mini - mini/firefox/kernel.config
# On top of arm64's defconfig, with every platform switched off: what a
# guest on BoltOS Mini's hypervisor has (virtio-mmio devices, a PL011, a
# PL031, GICv2, the virtual timer), what Firefox needs of a kernel, and
# nothing loaded later -- there are no modules.
-d MODULES
-d PCI
-d USB_SUPPORT
-d SOUND
-d WIRELESS
-d WLAN
-d BT
-d MEDIA_SUPPORT
-d KVM
-d VIRTUALIZATION
-d STAGING
-d FRAMEBUFFER_CONSOLE
-d DRM_FBDEV_EMULATION
-d DEBUG_INFO
-e DEBUG_INFO_NONE
-d HIBERNATION
-e VIRTIO_MENU
-e VIRTIO
-e VIRTIO_MMIO
-e VIRTIO_BLK
-e NETDEVICES
-e NET_CORE
-e VIRTIO_NET
-e VIRTIO_INPUT
-e DRM
-e DRM_VIRTIO_GPU
-e HW_RANDOM
-e HW_RANDOM_VIRTIO
-e SERIAL_AMBA_PL011
-e SERIAL_AMBA_PL011_CONSOLE
-e RTC_CLASS
-e RTC_HCTOSYS
-e RTC_DRV_PL031
-e INPUT_EVDEV
-e SQUASHFS
-e SQUASHFS_ZSTD
-e SQUASHFS_XZ
-e SQUASHFS_DECOMP_MULTI_PERCPU
-e SQUASHFS_FILE_DIRECT
-e OVERLAY_FS
-e EXT4_FS
-e TMPFS
-e TMPFS_POSIX_ACL
-e DEVTMPFS
-e DEVTMPFS_MOUNT
-e SWAP
-e ZSMALLOC
-e ZRAM
-e ZRAM_BACKEND_ZSTD
-e ZRAM_BACKEND_LZ4
-e LRU_GEN
-e LRU_GEN_ENABLED
-e CRYPTO_ZSTD
-e CRYPTO_LZ4
-e UNIX
-e INET
-e PACKET
-e SYSVIPC
-e POSIX_MQUEUE
-e SECCOMP
-e SECCOMP_FILTER
-e NAMESPACES
-e USER_NS
-e PID_NS
-e NET_NS
-e IPC_NS
-e UTS_NS
-e MEMFD_CREATE
-e INOTIFY_USER
-e FANOTIFY
-e EPOLL
-e SCHED_MC
-e BINFMT_SCRIPT

# BoltOS Mini: what is added to U-Boot's orangepi_zero3_defconfig.
#
# U-Boot is the Pi's firmware here, as UEFI is a PC's: it trains the DRAM,
# starts TF-A, and loads boltos.bin off the card's FAT partition. Before
# it does, it waits two seconds on the USB-C port as a DFU device, so the Mac
# can hand it a kernel to run instead (mini/tools/pi.py boot), read the log
# the last run left in RAM (pi.py log), or replace the kernel on the card
# (pi.py install) -- all without taking the card out.
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv dfu_alt_info 'ram 0=kernel ram 0x50000000 0x4000000;log ram 0x5f000000 0x100000&mmc 0=boltos.bin fat 0 1'; mw.l 0x50000038 0; led green:status on; dfu 0 2; led green:status off; if itest.l *0x50000038 == 0x644d5241; then booti 0x50000000 - ${fdtcontroladdr}; fi; if load mmc 0:1 0x50000000 boltos.bin; then booti 0x50000000 - ${fdtcontroladdr}; fi; led green:status on; dfu 0"
# CONFIG_USE_PREBOOT is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_CMD_DFU=y
CONFIG_DFU_RAM=y
CONFIG_DFU_MMC=y
CONFIG_DFU_TIMEOUT=y
CONFIG_SYS_DFU_DATA_BUF_SIZE=0x800000
CONFIG_SYS_DFU_MAX_FILE_SIZE=0x2000000
CONFIG_FAT_WRITE=y
CONFIG_CMD_LED=y
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_USB_GADGET_MANUFACTURER="BoltOS"
CONFIG_USB_GADGET_PRODUCT_NUM=0x1010
# A kernel that hangs is reset by the watchdog and comes back through the DFU
# window; BoltOS Mini keeps it fed from its timer tick.
CONFIG_WDT=y
CONFIG_WDT_SUNXI=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=16000
# Host tools that want GnuTLS/OpenSSL for signing; nothing here is signed.
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set

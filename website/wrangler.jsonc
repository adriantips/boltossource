{
  // Static site on Workers: no script, just the built files. Unknown paths
  // fall back to index.html so the client router can take /system/network.
  "name": "boltos",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "boltos.dev", "custom_domain": true },
    { "pattern": "www.boltos.dev", "custom_domain": true }
  ]
}
